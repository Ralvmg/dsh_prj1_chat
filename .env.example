# ===== QQChat 配置 =====
# 复制为 .env 并填写

# --- LLM API（必填）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=500

# --- 人设 ---
# 可选: whale-musume / gentle / tsundere
# 也可填 data/personas/ 下的自定义文件名
PERSONA=dafeiyu
BOT_NAME=

# --- OneBot ---
ONEBOT_WS_URL=ws://napcat:3001
ONEBOT_ACCESS_TOKEN=
RECONNECT_DELAY=5

# --- 回复策略（拟人化）---
HISTORY_LIMIT=20
REPLY_DELAY_MIN=0.8
REPLY_DELAY_MAX=2.5
SPLIT_REPLY=true
SPLIT_THRESHOLD=80

# --- 群聊策略 ---
# 触发词，逗号分隔。@机器人 始终会回复
GROUP_TRIGGERS=
# 命中触发词后的回复概率 0.0-1.0
GROUP_REPLY_PROB=1.0
# 群聊是否只响应 @
GROUP_AT_ONLY=false

# --- 记忆 ---
PROFILE_UPDATE_INTERVAL=10
PROFILE_UPDATE_COOLDOWN=600
HISTORY_KEEP_DAYS=30
HISTORY_KEEP_PER_SESSION=200

# --- 日志 ---
LOG_LEVEL=INFO

